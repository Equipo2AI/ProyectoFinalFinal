OLLAMA_HOST=http://localhost:11434

# Planner: hybrid (reglas + LLM para consultas mixtas), llm o rules
ORCHESTRATION_PLANNER=hybrid
# Síntesis multiagente: auto, llm o rules
ORCHESTRATION_SYNTHESIS=auto

# Opcional: sobrescribe el modelo de visión de models.yaml.
DOCUMENT_INTELLIGENCE_MODEL=

# Archivos subidos desde el chat. Con sesión autenticada solo se leen rutas
# dentro de esta raíz, aisladas por identidad. Relativa a la raíz del repo.
DOCUMENT_UPLOAD_ROOT=proyecto/data/uploads

# PDF: texto nativo primero; OCR local solo en páginas sin texto suficiente.
# DOCUMENT_PDF_MODEL es opcional; si se omite, usa document_pdf de models.yaml.
DOCUMENT_PDF_MODEL=
DOCUMENT_PDF_OCR_MAX_PAGES=20
DOCUMENT_PDF_DPI=150
DOCUMENT_PDF_TEXT_MIN_CHARS=20
MCP_DOCUMENT_TIMEOUT=1800

# Contexto documental privado por usuario (SQLite local; nunca Pinecone).
# Relativa a la raíz del repo.
DOCUMENT_CONTEXT_DB=proyecto/data/document_context.db
DOCUMENT_CONTEXT_TTL_DAYS=7
DOCUMENT_CONTEXT_MAX_DOCS=20
DOCUMENT_CONTEXT_MAX_CHARS=10000
DOCUMENT_CONTEXT_SUMMARY_CHARS=1200

# Ventana de conversación enviada al modelo
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARS=8000
CHAT_HISTORY_STORAGE_MESSAGES=80

PINECONE_API_KEY=
INDEX_NAME=

# RAG híbrido: candidatos recuperados y umbrales de relevancia.
# El score semántico se combina con cobertura léxica y coincidencia de fuente.
RAG_CANDIDATES=12
RAG_MIN_SCORE=0.25
RAG_STRONG_SCORE=0.70
RAG_MIN_COVERAGE=0.35
RAG_MIN_SOURCE_MATCH=0.50

# Caché de esquema/catálogo del Data Analyst. Guarda solo metadatos.
# Usa 0 para deshabilitarlo.
DATA_ANALYST_METADATA_CACHE=proyecto/data/data_analyst_metadata_cache.json
DATA_ANALYST_METADATA_CACHE_TTL=3600
# Inyecta el catálogo cacheado en el prompt para evitar tools de metadatos.
# Usa 0 para volver al comportamiento anterior.
DATA_ANALYST_PROMPT_CATALOG=1

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Agente-Datos

DATABASE_URL=
# demo: vista de demostracion; el acceso a datos siempre exige login
# local: exige login con .local_auth
PROYECTO_AUTH_MODE=local
# Carpeta privada de identidades. Si se omite, usa la ubicación del sistema.
PROYECTO_AUTH_DIR=
# Solo para procesos internos/CLI; no compartas estos valores.
# PROYECTO_AUTH_TOKEN=
# PROYECTO_AUTH_SUBJECT=

# Mitigación de carga de MiMo en Windows; 0 la desactiva.
PROYECTO_OLLAMA_MMAP=1

MCP_TIMEOUT=180
DEEPEVAL_RESULTS_FOLDER=deepeval/resultados
DEEPEVAL_CASOS_DIR=deepeval/casos
DEEPEVAL_JUEZ=ollama:qwen2.5:7b-instruct
DEEPEVAL_SOLO_REGLAS=0
# Rendimiento de la suite: presupuesto opcional por caso (segundos) y
# desactivación de la medición/tokens si hiciera falta.
DEEPEVAL_MAX_SEGUNDOS=
DEEPEVAL_RENDIMIENTO=1
DEEPEVAL_LLM_STATS=1
# Opcionales si se usa un juez Gemini/OpenAI en DeepEval.
GOOGLE_API_KEY=
GEMINI_API_KEY=
