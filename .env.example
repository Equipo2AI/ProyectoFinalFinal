# Ollama (LLM por defecto)
OLLAMA_HOST=http://localhost:11434

# Modelo multimodal para document_intelligence (debe estar descargado en Ollama)
DOCUMENT_INTELLIGENCE_MODEL=qwen2.5vl:7b

# FastOCR (opcional): OCR rápido vía API. Requiere `uv add fastocr-sdk`.
# Si se define, ocr_image lo usa; si no, cae a Qwen2.5-VL.
FASTOCR_API_KEY=

# OpenAI (opcional, solo si se cambia a modelo OpenAI)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Pinecone (para memoria semántica / RAG)
PINECONE_API_KEY=tu_pinecone_api_key_aqui
INDEX_NAME=tu_nombre_de_index

# LangSmith (opcional, para trazabilidad)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=tu_langsmith_api_key
LANGSMITH_PROJECT=Agente-Bancario-Banamex

# Base SQL para el Data Analyst (genera banco.db con proyecto/bd/cargar_bd.py)
DATABASE_URL=sqlite:///ruta/absoluta/a/proyecto/data/banco.db