OLLAMA_HOST=http://localhost:11434

ORCHESTRATION_MODE=graph
# Planner: hybrid (reglas + LLM para consultas mixtas), llm o rules
ORCHESTRATION_PLANNER=hybrid
# Síntesis multiagente: auto, llm o rules
ORCHESTRATION_SYNTHESIS=auto

DOCUMENT_INTELLIGENCE_MODEL=qwen2.5vl:7b

# PDF: texto nativo primero; OCR local solo en páginas sin texto suficiente.
DOCUMENT_PDF_MODEL=qwen2.5vl:3b
DOCUMENT_PDF_OCR_MAX_PAGES=20
DOCUMENT_PDF_DPI=150
DOCUMENT_PDF_TEXT_MIN_CHARS=20
MCP_DOCUMENT_TIMEOUT=1800

# Contexto documental privado por usuario (SQLite local; nunca Pinecone)
DOCUMENT_CONTEXT_DB=proyecto/data/document_context.db
DOCUMENT_CONTEXT_TTL_DAYS=7
DOCUMENT_CONTEXT_MAX_DOCS=20
DOCUMENT_CONTEXT_MAX_CHARS=10000
DOCUMENT_CONTEXT_SUMMARY_CHARS=1200

# Ventana de conversación enviada al modelo
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARS=8000
CHAT_HISTORY_STORAGE_MESSAGES=80

PINECONE_API_KEY=
INDEX_NAME=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Agente-Datos

DATABASE_URL=
# demo: vista de demostracion; el acceso a datos siempre exige login
# local: exige login con .local_auth
PROYECTO_AUTH_MODE=local
MCP_TIMEOUT=180
DEEPEVAL_RESULTS_FOLDER=deepeval/resultados
